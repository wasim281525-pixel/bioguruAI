# ============================================================
# BioGuru AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# App Security (REQUIRED)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256

# LLM Provider (REQUIRED — choose one)
ANTHROPIC_API_KEY=sk-ant-api03-...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Optional: Groq fallback (fast, free tier available)
GROQ_API_KEY=gsk_...

# Embedding Model
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Alternative: BAAI/bge-m3

# Vector Database
VECTOR_DB=chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000

# Optional: Pinecone (cloud vector DB)
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=bioguru

# PostgreSQL Database (REQUIRED)
DATABASE_URL=postgresql+asyncpg://bioguru:bioguru_secure_pass@postgres:5432/bioguru
DB_PASSWORD=bioguru_secure_pass

# Redis
REDIS_URL=redis://redis:6379

# Voice API (Optional — for STT/TTS features)
OPENAI_API_KEY=sk-...

# AWS S3 Storage (Optional — uses local storage by default)
# S3_BUCKET=bioguru-uploads
# AWS_ACCESS_KEY=AKIA...
# AWS_SECRET_KEY=...

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# CORS Origins (comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Retrieval Settings
TOP_K=5
SIMILARITY_THRESHOLD=0.5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
